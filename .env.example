# Ampara — variáveis de ambiente de exemplo.
# Copie para `.env` (ou exporte no ambiente) e preencha. NÃO use segredos reais aqui.

# Chave de sessão Flask. Gere uma aleatória em produção.
SECRET_KEY=change-me

# Caminho do arquivo do banco SQLite (criado por init-db se não existir).
DATABASE=ampara.db

# Precisão da grade geográfica (casas decimais no arredondamento de lat/lng).
# Ausente => usa a precisão padrão da aplicação.
GRID_PRECISION=2

# Diretório onde imagens das ocorrências são gravadas.
UPLOAD_FOLDER=uploads

# Conta de admin (opcional). Usada por `flask --app app create-admin` (depois de
# `flask --app app init-db`); falha se o e-mail já existir. Também aceita
# --email/--password.
# Senha entre 8 e 128 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Credenciais SMTP (opcionais). Ausentes => notificações em modo simulado.
# Preencha para habilitar o envio real por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
